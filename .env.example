# Postgres (consumed by docker-compose)
POSTGRES_USER=chelaa
POSTGRES_PASSWORD=chelaa
POSTGRES_DB=chelaa
POSTGRES_PORT=5432

# Go API
DATABASE_URL=postgres://chelaa:chelaa@localhost:5432/chelaa?sslmode=disable
PORT=4120
CORS_ORIGIN=http://localhost:4100

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:4120

# Cloudflare R2 (image uploads) — leave empty to use local disk in dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Email (password resets + activity notifications).
# Without RESEND_API_KEY the API logs messages instead of sending them.
RESEND_API_KEY=
MAIL_FROM=Chelaa <noreply@chelaa.tech>
APP_URL=http://localhost:4100
